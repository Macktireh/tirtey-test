---
const year = new Date().getFullYear();
---

<footer class="bg-gray-900 text-gray-400">
  <div class="max-w-6xl mx-auto px-4 py-14">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-10">

      <div>
        <div class="mb-4">
          <span class="text-xl font-bold text-white">Tirtey</span>
          <span class="text-xl font-bold text-amber-400">Reisen</span>
        </div>
        <p class="text-sm leading-relaxed mb-3">
          Reisebüro &amp; Omnibusbetrieb Tirtey GmbH &amp; Co. KG<br />
          Ihr verlässlicher Partner im Kreis Düren.<br />
          VRS-Partner · Buslinie L922
        </p>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Navigation</h3>
        <ul class="space-y-2 text-sm">
          {[
            { href: '/', label: 'Startseite' },
            { href: '/schuelerreisen', label: 'Schülerreisen' },
            { href: '/gruppenreisen', label: 'Gruppenreisen' },
            { href: '/busvermietung', label: 'Busvermietung' },
            { href: '/kontakt', label: 'Kontakt' },
          ].map(link => (
            <li>
              <a href={link.href} class="hover:text-amber-400 transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <div>
        <h3 class="text-white font-semibold mb-4 text-sm uppercase tracking-wider">Kontakt</h3>
        <ul class="space-y-3 text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 mt-0.5 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
            </svg>
            <span>Am Finkelbach 10<br/>52445 Titz-Rödingen</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
            </svg>
            <a href="tel:+492463991100" class="hover:text-amber-400 transition-colors">+49 2463 99 11-0</a>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-amber-400 shrink-0" fill="currentColor" viewBox="0 0 20 20">
              <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
              <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
            </svg>
            <a href="mailto:info@tirtey-reisen.de" class="hover:text-amber-400 transition-colors">info@tirtey-reisen.de</a>
          </li>
          <li class="text-xs text-gray-600 pl-7">Mo. – Fr.: 08:30 – 17:00 Uhr</li>
        </ul>
      </div>
    </div>

    <div class="border-t border-gray-800 mt-10 pt-6 flex flex-col sm:flex-row justify-between items-center gap-2 text-xs text-gray-600">
      <p>Copyright &copy; 2009 – {year} Reisebüro &amp; Omnibusbetrieb Tirtey, 52445 Rödingen</p>
      <div class="flex gap-4">
        <a href="/impressum" class="hover:text-gray-400 transition-colors">Impressum</a>
        <a href="/datenschutz" class="hover:text-gray-400 transition-colors">Datenschutz</a>
      </div>
    </div>
  </div>
</footer>
