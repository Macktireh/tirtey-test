---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import '../styles/input.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Tirtey Reisen',
  description = 'Ihr zuverlässiger Partner für Schülerreisen, Gruppenreisen und Busvermietung in Deutschland.',
} = Astro.props;

const pageTitle = title === 'Tirtey Reisen' ? title : `${title} | Tirtey Reisen`;
---

<!doctype html>
<html lang="de">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
  </head>
  <body class="min-h-screen flex flex-col bg-white text-gray-800 antialiased">
    <Nav />
    <main class="flex-1">
      <slot />
    </main>
    <Footer />
  </body>
</html>
