---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Kontakt"
  description="Kontaktformular zum Senden einer Nachricht an den Omnibusbetrieb Tirtey, Reisebüro &amp; Omnibusbetrieb Tirtey."
>

  <!-- Hero -->
  <section class="bg-blue-900 py-16 px-4 text-center text-white">
    <p class="text-amber-400 font-semibold text-sm uppercase tracking-widest mb-3">Tirtey Reisen</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-3">Kontakt</h1>
    <p class="text-xl text-blue-200">Schicken Sie uns eine Nachricht</p>
  </section>

  <!-- Breadcrumb -->
  <nav class="bg-gray-50 border-b border-gray-200 px-4 py-3 text-sm text-gray-500">
    <div class="max-w-6xl mx-auto flex items-center gap-2">
      <a href="/" class="hover:text-blue-700 transition-colors">Startseite</a>
      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
      <span class="text-gray-900 font-medium">Kontakt</span>
    </div>
  </nav>

  <!-- Three-column layout matching original: col1 (address) | col2 (map) | col3 (form) -->
  <section class="py-16 px-4 bg-gray-50">
    <div class="max-w-6xl mx-auto grid grid-cols-1 md:grid-cols-3 gap-8">

      <!-- col1: Address box -->
      <div class="space-y-6">
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <h3 class="font-bold text-gray-900 text-lg mb-4">Reisebüro &amp; Omnibusbetrieb Tirtey</h3>
          <address class="not-italic space-y-3 text-sm text-gray-600">
            <div class="flex items-start gap-3">
              <svg class="w-4 h-4 text-amber-500 mt-0.5 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
              </svg>
              <span>Am Finkelbach 10<br />D-52445 Titz-Rödingen</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2 3a1 1 0 011-1h2.153a1 1 0 01.986.836l.74 4.435a1 1 0 01-.54 1.06l-1.548.773a11.037 11.037 0 006.105 6.105l.774-1.548a1 1 0 011.059-.54l4.435.74a1 1 0 01.836.986V17a1 1 0 01-1 1h-2C7.82 18 2 12.18 2 5V3z"/>
              </svg>
              <span>
                Tel.: <a href="tel:+492463991100" class="text-blue-700 hover:text-amber-500 transition-colors">02463 / 99 11-0</a>
              </span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path fill-rule="evenodd" d="M3 5a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 10a1 1 0 011-1h12a1 1 0 110 2H4a1 1 0 01-1-1zM3 15a1 1 0 011-1h6a1 1 0 110 2H4a1 1 0 01-1-1z" clip-rule="evenodd"/>
              </svg>
              <span>Fax: 02463 / 99 11-22</span>
            </div>
            <div class="flex items-center gap-3">
              <svg class="w-4 h-4 text-amber-500 shrink-0" fill="currentColor" viewBox="0 0 20 20">
                <path d="M2.003 5.884L10 9.882l7.997-3.998A2 2 0 0016 4H4a2 2 0 00-1.997 1.884z"/>
                <path d="M18 8.118l-8 4-8-4V14a2 2 0 002 2h12a2 2 0 002-2V8.118z"/>
              </svg>
              <a href="mailto:info@tirtey-reisen.de" class="text-blue-700 hover:text-amber-500 transition-colors">info@tirtey-reisen.de</a>
            </div>
          </address>

          <div class="mt-5 pt-5 border-t border-gray-100">
            <p class="text-sm font-semibold text-gray-900 mb-1">Öffnungszeiten</p>
            <p class="text-sm text-gray-600">Mo. – Fr.: 08:30 – 17:00 Uhr</p>
          </div>
        </div>

        <!-- Quick links to other services -->
        <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-6">
          <h4 class="font-semibold text-gray-900 mb-3 text-sm">Weitere Anfragen</h4>
          <div class="space-y-2">
            {[
              { href: '/schuelerreisen', label: '🎒 Schülerreisen' },
              { href: '/gruppenreisen', label: '👥 Gruppenreisen' },
              { href: '/busvermietung', label: '🚌 Busvermietung' },
            ].map(link => (
              <a href={link.href} class="flex items-center justify-between bg-gray-50 hover:bg-blue-50 border border-gray-100 hover:border-blue-200 rounded-lg px-3 py-2.5 text-sm text-gray-700 hover:text-blue-800 transition-colors">
                {link.label}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            ))}
          </div>
        </div>
      </div>

      <!-- col2: Routenplaner / Map -->
      <div class="space-y-4">
        <h2 class="text-xl font-bold text-gray-900">Routenplaner:</h2>
        <p class="text-sm text-gray-500 text-center font-medium">Über Google Maps</p>
        <a
          href="https://maps.google.de/maps?q=Am+Finkelbach+10,+52445+Titz-R%C3%B6dingen"
          target="_blank"
          rel="noopener noreferrer"
          class="block rounded-xl overflow-hidden border border-gray-200 shadow-sm hover:shadow-md transition-shadow group"
        >
          <div class="relative h-52 bg-gray-200 flex items-center justify-center">
            <img
              src="https://picsum.photos/seed/map-titz/400/300"
              alt="Karte – Titz-Rödingen"
              class="w-full h-full object-cover group-hover:opacity-90 transition-opacity"
            />
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="bg-white/90 backdrop-blur-sm rounded-xl px-4 py-3 text-center shadow-md">
                <div class="text-3xl mb-1">📍</div>
                <p class="font-semibold text-gray-900 text-sm">Klick für Google Maps</p>
                <p class="text-xs text-gray-500 mt-0.5">Titz-Rödingen öffnen</p>
              </div>
            </div>
          </div>
        </a>
        <p class="text-xs text-gray-400 text-center">Am Finkelbach 10, 52445 Titz-Rödingen</p>

        <!-- Opening hours card -->
        <div class="bg-amber-50 border border-amber-100 rounded-xl p-5 mt-4">
          <h4 class="font-semibold text-gray-900 mb-2 text-sm">Öffnungszeiten</h4>
          <table class="text-sm text-gray-600 w-full">
            <tbody>
              <tr>
                <td class="py-0.5 font-medium pr-4">Mo. – Fr.</td>
                <td>08:30 – 17:00 Uhr</td>
              </tr>
              <tr>
                <td class="py-0.5 font-medium pr-4">Sa. – So.</td>
                <td class="text-gray-400">geschlossen</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>

      <!-- col3: Contact form -->
      <div class="bg-white rounded-2xl shadow-sm border border-gray-100 p-7">
        <h2 class="text-xl font-bold text-gray-900 mb-2">Schicken Sie uns eine Nachricht</h2>
        <p class="text-xs text-gray-500 mb-6">
          Felder mit <span class="text-red-500 font-bold">„*"</span> sind Pflichtfelder.
        </p>

        <form class="space-y-4" novalidate>
          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="anrede">Anrede</label>
            <select id="anrede" name="anrede"
              class="w-full border border-gray-300 bg-white rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            >
              <option value="Herr">Herr</option>
              <option value="Frau">Frau</option>
              <option value="Divers">Divers</option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="vorname">Vorname</label>
            <input type="text" id="vorname" name="vorname" autocomplete="given-name"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="nachname">
              Nachname <span class="text-red-500">*</span>
            </label>
            <input type="text" id="nachname" name="nachname" required autocomplete="family-name"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="email">
              E-Mail <span class="text-red-500">*</span>
            </label>
            <input type="email" id="email" name="email" required autocomplete="email"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="telefon">Telefonnummer</label>
            <input type="tel" id="telefon" name="telefon" autocomplete="tel"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="strasse">Straße</label>
            <input type="text" id="strasse" name="strasse" autocomplete="street-address"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>

          <div class="grid grid-cols-2 gap-3">
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5" for="plz">PLZ</label>
              <input type="number" id="plz" name="plz" maxlength="5" autocomplete="postal-code"
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>
            <div>
              <label class="block text-sm font-medium text-gray-700 mb-1.5" for="ort">Ort</label>
              <input type="text" id="ort" name="ort" autocomplete="address-level2"
                class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent"
              />
            </div>
          </div>

          <div>
            <label class="block text-sm font-medium text-gray-700 mb-1.5" for="nachricht">Nachricht</label>
            <textarea id="nachricht" name="nachricht" rows="4"
              class="w-full border border-gray-300 rounded-lg px-4 py-2.5 text-sm focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent resize-none"
            ></textarea>
          </div>

          <div class="flex gap-3 pt-1">
            <button type="reset"
              class="flex-1 border border-gray-300 text-gray-600 hover:bg-gray-50 font-medium py-2.5 rounded-xl transition-colors text-sm"
            >
              Alle Felder löschen
            </button>
            <button type="submit"
              class="flex-1 bg-blue-900 hover:bg-blue-800 text-white font-semibold py-2.5 rounded-xl transition-colors text-sm shadow-sm"
            >
              Nachricht absenden
            </button>
          </div>

          <hr class="border-gray-200" />
          <p class="text-xs text-gray-500 text-center">
            Sie erhalten eine Kopie Ihrer Nachricht an Ihre oben eingetragene E-Mail-Adresse geschickt.
          </p>
        </form>
      </div>
    </div>
  </section>

</Layout>
